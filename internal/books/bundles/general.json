    {
      "id": "general-inspection",
      "code": "T6",
      "title": "Hygiene inspection",
      "builder": "checklist",
      "checklist": [
        {
          "title": "Premises and equipment",
          "items": [
            "Rooms and equipment clean and in good repair?",
            "Food-contact surfaces clean and disinfected?",
            "Cleaning chemicals and cloths suitable and stored correctly?"
          ]
        },
        {
          "title": "Storage",
          "items": [
            "Ready-to-eat food stored above or apart from raw food?",
            "Food covered, labelled and in date?",
            "Fridges and freezers working?"
          ]
        },
        {
          "title": "Handling",
          "items": [
            "Raw and ready-to-eat food prepared apart, or surfaces disinfected between?",
            "Probe thermometers used and cleaned correctly?",
            "Staff aware of allergens?"
          ]
        },
        {
          "title": "Staff",
          "items": [
            "Staff fit to work, in clean protective clothing?",
            "Hand-wash basins stocked and used only for hand washing?"
          ]
        },
        {
          "title": "Pests and waste",
          "items": [
            "No signs of pests?",
            "Waste stored correctly and bins clean?"
          ]
        },
        {
          "title": "Records",
          "items": [
            "All checks recorded, with corrective actions?"
          ]
        }
      ],
      "columns": [
        {
          "label": "Check",
          "field": "item",
          "width": 130
        },
        {
          "label": "Yes",
          "field": "yes",
          "width": 16
        },
        {
          "label": "No",
          "field": "no",
          "width": 16
        },
        {
          "label": "Action taken",
          "field": "action",
          "width": 111
        }
      ]
    },
