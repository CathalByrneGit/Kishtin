      "title": "Fitness to Work Assessment",
      "source": {
        "url": "https://www.fsai.ie/getmedia/1c707005-0675-4255-beb3-3451ae9170d3/SC7-2012-fitness.pdf",
        "published": "2012-10",
        "sha256": "6b84783af694aed20946adf17546e53807554b1f712b50ced4c802270ab66f8b"
      },
      "missing": "Kishtin does not keep fitness to work assessments. They hold health information, so keep them on paper for now."
    },
    {
      "id": "fsai-sc8",
      "code": "SC8",
      "title": "All-in-One Daily Record",
      "source": {
        "url": "https://www.fsai.ie/getmedia/c577594c-faac-4330-9f6a-5c604e0af585/Safe-Catering-Pack-Record-Books-8-(All-in-One-Daily-Record).pdf",
        "published": "2020-02",
        "sha256": "0058cd03d73d8815304d9fe9aa34e5e0bd0d33a50f98ae375b882aebaa95931a"
      },
