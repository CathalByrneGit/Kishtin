{
  "id": "fsai-safe-catering",
  "name": "FSAI Safe Catering record books",
  "country": "Ireland",
  "issuer": "Food Safety Authority of Ireland",
  "jurisdiction": "IE",
  "language": "en",
  "url": "https://www.fsai.ie/publications/safe-catering-pack-record-books",
  "templates": [
    {
      "id": "fsai-sc1",
      "code": "SC1",
      "title": "Food Delivery Records",
      "source": {
        "url": "https://www.fsai.ie/getmedia/d48ce1a3-f504-4cf8-be09-9b792e719dbc/Safe-Catering-Pack-Record-Books-1-(Food-Delivery).pdf",
        "published": "2020-02",
        "sha256": "b1ec332172e5fa32565c208e0bbd3bfbf05d3a92c1e66968e5510759e777ac40"
      },
      "missing": "Kishtin does not record the batch code, use-by date or delivery vehicle check this booklet asks for yet."
    },
    {
      "id": "fsai-sc2",
      "code": "SC2",
      "title": "Fridge/Freezer/Chill Display Temperature Records",
      "source": {
        "url": "https://www.fsai.ie/getmedia/0e2f40b3-271d-48cf-877b-3963268bf931/SC2-2012-refrigeration.pdf",
        "published": "2012-10",
        "sha256": "b987e38308398fda3b688a987e69de6ce9a9eaeb3511a7fc75d53b1e4ff528e9"
      },
      "builder": "unit_grid",
      "units_per_page": 6,
      "columns": [
        {
          "label": "Date",
          "field": "date",
          "width": 14
        },
        {
          "label": "Unit",
          "field": "unit_checks",
          "width": 168
        },
        {
          "label": "Comments/Action",
          "field": "comments",
          "width": 66
        },
        {
          "label": "Sign",
          "field": "signed",
          "width": 25
        }
      ],
      "notes": [
        "Chilled food: 0°C to 5°C; frozen food: less than or equal to -18°C.",
        "It is recommended that fridge/freezer temperatures are checked at least once per day. Some businesses may wish to check fridges more frequently."
      ],
      "manager_check": true
    },
    {
      "id": "fsai-sc3",
      "code": "SC3",
      "title": "Cooking/Cooling/Reheating Records",
      "source": {
        "url": "https://www.fsai.ie/getmedia/09587431-fce2-4b7f-93b3-3e061fa630b6/Safe-Catering-Pack-Record-Books-3-(Cooking-Cooling-Reheating).pdf",
        "published": "2020-02",
        "sha256": "c61c4793c8d3e24ab2108103f981b05120be33463ca8403b53d40da000a613ec"
      },
      "builder": "cooking",
      "columns": [
        {
          "label": "Date",
          "field": "date",
          "width": 17
        },
        {
          "label": "Food",
          "field": "food",
          "width": 42
        },
        {
          "label": "Time started cooking",
          "group": "Cooking",
          "fixed": "N/A",
          "fixed_when": "core_temp",
          "width": 18
        },
        {
          "label": "Time finished cooking",
          "group": "Cooking",
          "field": "cook_finished",
          "width": 18
        },
        {
          "label": "Core temp",
          "group": "Cooking",
          "field": "core_temp",
          "width": 18
        },
        {
          "label": "Signed",
          "group": "Cooking",
          "field": "cook_signed",
          "width": 19
        },
        {
          "label": "Time into fridge/blast chiller",
          "group": "Cooling",
          "field": "into_fridge",
          "width": 22
        },
        {
          "label": "Signed",
          "group": "Cooling",
          "field": "cool_signed",
          "width": 19
        },
        {
          "label": "Core temp",
          "group": "Reheating",
          "field": "reheat_temp",
          "width": 18
        },
        {
          "label": "Signed",
          "group": "Reheating",
          "field": "reheat_signed",
          "width": 19
        },
        {
          "label": "Comments/Action",
          "field": "comments",
          "width": 49
        },
        {
          "label": "Kishtin ref",
          "field": "ref",
          "width": 14
        }
      ],
      "notes": [
        "Cooking: core temperature 75°C or above. Cooling: cool food as quickly as possible and place in fridge within 2 hours. Time finished cooking needs to be recorded if food is being cooled. Reheating: core temperature 70°C or above.",
        "It is not necessary to record the time started cooking, if the core temperature is checked."
      ],
      "manager_check": true
    },
    {
      "id": "fsai-sc4",
      "code": "SC4",
      "title": "Hot Hold/Display Records",
      "source": {
        "url": "https://www.fsai.ie/getmedia/1546c484-e68a-4b1e-afef-026a33f5d0f6/Safe-Catering-Pack-Record-Books-4-(Hot-Hold-Display).pdf",
        "published": "2020-02",
        "sha256": "55035b8233ea5131d8e6907cfafa751a28bf532cb621818024da69a77d33609c"
      },
      "builder": "hot_hold",
      "columns": [
        {
          "label": "Date",
          "field": "date",
          "width": 18
        },
        {
          "label": "Food",
          "field": "food",
          "width": 56
        },
        {
          "label": "Time into hot hold",
          "width": 22
        },
        {
          "label": "Core temp (1st check)",
          "field": "check_1",
          "width": 27
        },
        {
          "label": "Core temp (2nd check)",
          "field": "check_2",
          "width": 27
        },
        {
          "label": "Core temp (3rd check)",
          "field": "check_3",
          "width": 27
        },
        {
          "label": "Comments/Action",
          "field": "comments",
          "width": 60
        },
        {
          "label": "Signed",
          "field": "signed",
          "width": 22
        },
        {
          "label": "Kishtin ref",
          "field": "ref",
          "width": 14
        }
      ],
      "notes": [
        "Keep hot food at or above 63°C."
      ],
      "manager_check": true
    },
    {
      "id": "fsai-sc5",
      "code": "SC5",
      "title": "Hygiene Inspection Checklist",
      "source": {
        "url": "https://www.fsai.ie/getmedia/b601f203-5062-43d4-b9d7-5bd1a2e7d7d5/SC5-2012-inspection.pdf",
        "published": "2012-10",
        "sha256": "378c70cb1dd02698a0aa78546a5631172640ce40e2b68170f5f0ad846738cfe2"
      },
      "missing": "Kishtin has no hygiene inspection checklist yet."
